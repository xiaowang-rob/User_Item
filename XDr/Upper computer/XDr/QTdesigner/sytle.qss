/* ==================== 全局深色主题基础设置 ==================== */
/*直接添加到qtdesigner的mainwidiget的style中*/
/* 应用于主窗口、对话框、普通控件容器，设置整体背景和默认文字 */
MainWindow,
QDialog,
QWidget {
    background-color: #353535;
    /* 主背景：深灰 */
    color: #ABB2BF;
    /* 默认文字颜色：白色 */
    font-family: 'Segoe UI', Arial, sans-serif;
    /* 使用现代无衬线字体 */
}

/* 所有 QLabel 文字颜色设为白色（确保与背景对比清晰） */
QLabel {
    color: #ABB2BF;
}

/* ==================== 输入类控件通用样式 ==================== */
/* 包括单行文本框、整数/浮点微调框、下拉框等 */
QLineEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox,
QAbstractSpinBox {
    background-color: #2e2a31;
    /* 输入区域背景：略带紫调的深灰 */
    border: 1px solid #555555;
    /* 边框：中灰色 */
    color: #ABB2BF;
    /* 输入文字颜色：浅灰蓝（比纯白更柔和） */
    padding: 2px;
    /* 内边距，避免文字贴边 */
    selection-background-color: #25425f;
    /* 选中文本背景：亮蓝色 */
    selection-color: white;
    /* 选中文本颜色：白色 */
    border-radius: 10px;
    /* 大圆角，现代感更强 */
}

/* 获得焦点时（用户点击或 Tab 切入），边框高亮为蓝色 */
QLineEdit:focus,
QSpinBox:focus,
QComboBox:focus {
    border: 1px solid #076122;
    /* 聚焦边框：亮蓝色，提示当前输入位置 */
}

/* ==================== QComboBox 特定样式 ==================== */
/* 下拉箭头区域：隐藏边框，固定宽度 */
QComboBox::drop-down {
    border: none;
    /* 去掉下拉按钮的边框 */
    width: 20px;
    /* 下拉区域宽度 */
}


QComboBox {
    padding-left: 10px;
    padding-right: 10px;
    text-align: center;
    /* 尝试设置，部分版本有效 */
}

/* ==================== 按钮通用样式 ==================== */
QPushButton {
    background-color: #23272E;
    /* 按钮背景：深灰 */
    border: 1px solid #616161;
    /* 边框：中灰 */
    color: #ABB2BF;
    /* 文字：白色 */
    padding: 4px 8px;
    /* 内边距（上下4px，左右8px） */
    min-width: 70px;
    /* 最小宽度，避免按钮太窄 */
    border-radius: 10px;
    /* 小圆角，保持简洁 */
    font-weight: normal;
    /* 正常字重（非粗体） */
}

QPushButton:checked {
    background-color: #56cf8d;
    /* 开启时变为蓝色 */
    color: #3f4247;
    border: 1px solid #217edb00;
    font-weight: bold;
}

/* 鼠标悬停效果 */
QPushButton:hover {
    background-color: #3a3a3e;
    /* 背景稍亮 */
    border: 1px solid #777777;
    /* 边框变亮，增强反馈 */
}

/* 按下状态 */
QPushButton:pressed {
    background-color: #1a1a1e;
    /* 背景变暗，模拟“按下”感 */
    border: 1px solid #333333;
    /* 边框变暗 */
}

/* 禁用状态 */
QPushButton:disabled {
    color: #afafaf;
    /* 文字变灰 */
    background-color: #2a2a2e;
    /* 背景保持但不可交互 */
    border: 1px solid #444444;
    /* 边框变暗灰 */
}


/* ==================== 分组框（GroupBox）样式 ==================== */
QGroupBox {
    border: 1px solid #555555;
    /* 边框 */
    margin-top: 1ex;
    /* 顶部留出标题空间 */
    font-weight: bold;
    /* 标题加粗 */
    color: #cec9c9;
    /* 标题文字：浅灰 */
}

/* 标题位置 */
QGroupBox::title {
    subcontrol-origin: margin;
    /* 相对于 margin 定位 */
    left: 5px;
    /* 左偏移 */
    padding: 0 3px 0 3px;
    /* 标题内边距 */
}

/* ==================== 标签页（TabWidget）样式 ==================== */
/* 标签页内容面板 */
QTabWidget::pane {
    border: 1px solid #555555;
    /* 面板边框 */
    background-color: #232326;
    /* 面板背景：深灰 */
}

/* 单个标签页 */
QTabBar::tab {
    background-color: #2a2a2e;
    /* 未选中标签背景 */
    color: #cccccc;
    /* 未选中文字：浅灰 */
    padding: 5px 10px;
    /* 内边距 */
    border: 1px solid #555555;
    /* 边框 */
    border-bottom: none;
    /* 底部无边框，与 pane 无缝衔接 */
    margin-right: 2px;
    /* 标签之间留空隙 */
}

/* 选中的标签页 */
QTabBar::tab:selected {
    background-color: #353535;
    /* 背景与主窗口一致 */
    color: white;
    /* 文字变白 */
    border-top: 2px solid #2a82da;
    /* 顶部加蓝色高亮条，表示激活 */
}

/* ==================== 滑块控件（QSlider）样式 ==================== */
/* 水平滑块轨道 */
QSlider::groove:horizontal {
    border: 1px solid #555555;
    height: 6px;
    /* 轨道高度 */
    background: #232326;
    /* 轨道背景：深灰 */
    margin: 0px;
    /* 与滑块对齐 */
    border-radius: 3px;
    /* 圆角轨道 */
}

/* 垂直滑块轨道 */
QSlider::groove:vertical {
    border: 1px solid #555555;
    width: 6px;
    /* 轨道宽度 */
    background: #232326;
    margin: 0px;
    border-radius: 3px;
}

/* 水平滑块已滑过部分（激活部分） */
QSlider::sub-page:horizontal {
    background: #2ae6dc;
    /* 强调蓝色，表示已选择范围 */
    border-radius: 3px;
}

/* 垂直滑块已滑过部分（从底部到滑块） */
QSlider::sub-page:vertical {
    background: #2a82da;
    border-radius: 3px;
}

/* 滑块手柄（可拖动的圆点/方块） */
QSlider::handle {
    background: #5f5fca;
    /* 手柄背景：略亮于轨道 */
    border: 1px solid #55555500;
    width: 16px;
    height: 16px;
    margin: -5px;
    /* 负边距使手柄覆盖轨道，居中显示 */
    border-radius: 8px;
    /* 圆形手柄（宽高相等 + 半径=宽/2） */
}

/* 手柄悬停效果 */
QSlider::handle:hover {
    background: #4a4a4e;
    border: 1px solid #777777;
}

/* 手柄按下效果 */
QSlider::handle:pressed {
    background: #2a82da;
    /* 按下时变为强调色，增强反馈 */
    border: 1px solid #2a82da;
}

/* 可选：禁用状态下的滑块 */
QSlider:disabled {
    opacity: 0.6;
    /* 整体变灰（Qt 5.12+ 支持） */
}