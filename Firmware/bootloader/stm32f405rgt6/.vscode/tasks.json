{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "编译",
            "type": "shell",
            "command": "python3 tools/build.py build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "icon": {
                "id": "gear",
                "tooltip": "编译项目"
            }
        },
        {
            "label": "重编译",
            "type": "shell",
            "command": "rm -rf build && python3 tools/build.py build",
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "icon": {
                "id": "debug-rerun",
                "tooltip": "清理并重新编译"
            }
        },
        {
            "label": "烧录",
            "type": "shell",
            "command": "python3 tools/build.py flash",
            "group": "test",
            "problemMatcher": [],
            "icon": {
                "id": "zap",
                "tooltip": "仅烧录"
            }
        },
        {
            "label": "编译并烧录",
            "type": "shell",
            "command": "python3 tools/build.py bf",
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "icon": {
                "id": "rocket",
                "tooltip": "编译并烧录"
            }
        },
        {
            "label": "擦除",
            "type": "shell",
            "command": "python3 tools/build.py erase",
            "problemMatcher": [],
            "icon": {
                "id": "trash",
                "tooltip": "擦除芯片"
            }
        },
        {
            "label": "清理",
            "type": "shell",
            "command": "python3 tools/build.py clean",
            "problemMatcher": []
        },
        {
            "label": "CheckAndFlash",
            "type": "shell",
            "command": "python3",
            "args": [
                "${workspaceFolder}/tools/check_flash.py"
            ],
            "group": "build",
            "problemMatcher": []
        }
    ]
}